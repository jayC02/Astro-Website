---
import Section from "./Section.astro";

const steps = [
  { n: "01", title: "Import your drawings", desc: "Upload PDFs/DWGs and select your project type, address and scope." },
  { n: "02", title: "Auto-generate the pack", desc: "The system builds the warrant/planning documents, schedules and notes from your inputs." },
  { n: "03", title: "Review & submit", desc: "Make edits, export a clean bundle, then submit with confidence." },
];
---

<Section
  id="how-it-works"
  eyebrow="How it works"
  title="From drawings to submission-ready documents"
  subtitle="A guided workflow that standardises output quality and cuts admin time without sacrificing control."
>
  <div class="grid gap-6 md:grid-cols-3">
    {steps.map((s) => (
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
        <div class="text-xs tracking-[0.28em] uppercase text-white/50">{s.n}</div>
        <h3 class="mt-3 text-xl font-semibold text-white">{s.title}</h3>
        <p class="mt-2 text-white/70 leading-relaxed">{s.desc}</p>
      </div>
    ))}
  </div>
</Section>