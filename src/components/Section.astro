---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  align?: "left" | "center";
  size?: "sm" | "md" | "lg";
  class?: string; // optional extra classes for the <section>
}

const {
  id,
  eyebrow,
  title,
  subtitle,
  align = "left",
  size = "md",
  class: extraClass = "",
} = Astro.props as Props;

const padMap: Record<NonNullable<Props["size"]>, string> = {
  sm: "py-16 md:py-20",
  md: "py-20 md:py-28",
  lg: "py-24 md:py-36",
};

const alignCls = align === "center"
  ? "text-center items-center"
  : "text-left items-start";

const pad = padMap[size];
---

<section
  id={id}
  class={`relative section-bg ${pad} ${extraClass}`.trim()}
>
  {/* subtle overlay to help sections feel cohesive with the hero */}
  <div class="pointer-events-none absolute inset-0 opacity-60">
    <div class="absolute inset-0 bg-gradient-to-b from-white/0 via-white/0 to-black/15"></div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-6">
    <header class={`flex flex-col gap-4 ${alignCls}`}>
      {eyebrow && (
        <p class="text-xs tracking-[0.28em] uppercase text-white/60">
          {eyebrow}
        </p>
      )}

      {title && (
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-white">
          {title}
        </h2>
      )}

      {subtitle && (
        <p class="max-w-2xl text-base md:text-lg text-white/70 leading-relaxed">
          {subtitle}
        </p>
      )}
    </header>

    <div class="mt-10 md:mt-14">
      <slot />
    </div>
  </div>
</section>