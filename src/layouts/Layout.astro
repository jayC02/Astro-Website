---
import "../styles/global.css"; // make sure global.css is in src/styles/
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const { title = "WarrantFlow", description = "Automate building warrant & planning permission document packs." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-black text-white">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>