---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://scotlandepc.com/' },
    { '@type': 'ListItem', position: 2, name: 'EPC Bishopbriggs', item: 'https://scotlandepc.com/epc-bishopbriggs' },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'EPC assessments in Bishopbriggs',
  serviceType: 'Domestic EPC / RdSAP assessment',
  provider: { '@type': 'LocalBusiness', name: 'Scotland EPC', telephone: '+44 7483 881889' },
  areaServed: ['Bishopbriggs', 'Kirkintilloch', 'Lenzie', 'Springburn', 'Robroyston', 'Bearsden', 'Glasgow'],
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: '70', description: 'Domestic EPCs from £70.' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who needs an EPC in Bishopbriggs?',
      acceptedAnswer: { '@type': 'Answer', text: 'An EPC is commonly needed when selling or renting a domestic property. Scotland EPC supports Bishopbriggs landlords, homeowners, sellers and agents.' },
    },
    {
      '@type': 'Question',
      name: 'What property types can be assessed?',
      acceptedAnswer: { '@type': 'Answer', text: 'Flats, houses, bungalows, maisonettes and other domestic property types can be quoted through the online form.' },
    },
    {
      '@type': 'Question',
      name: 'Do you cover areas around Bishopbriggs?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Nearby areas include Kirkintilloch, Lenzie, Springburn, Robroyston, Bearsden and Glasgow.' },
    },
  ],
};
---

<Layout
  title="EPC Bishopbriggs | Domestic RdSAP Assessments | Scotland EPC"
  description="Need an EPC in Bishopbriggs? Scotland EPC provides domestic RdSAP assessments for landlords, sellers, homeowners and agents, with EPCs from £70."
  canonicalPath="/epc-bishopbriggs"
>
  <section class="local-page">
    <div class="container-pro max-w-4xl space-y-6">
      <p class="badge">Bishopbriggs EPC appointments</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">EPC Assessments in Bishopbriggs</h1>
      <p class="text-lg text-slate-700">Book a domestic EPC/RdSAP assessment in Bishopbriggs with clear pricing and a simple enquiry process. Scotland EPC helps landlords, sellers, homeowners, letting agents and property managers get the documentation they need for rentals, sales and compliance checks.</p>

      <div class="quote-card border-sky-200 bg-sky-50">
        <h2 class="text-2xl font-semibold text-slate-900">Who this is for</h2>
        <p class="mt-2 text-slate-700">Landlords preparing a tenancy, homeowners planning to sell, letting agents arranging paperwork, and property managers coordinating multiple domestic properties.</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">EPC pricing</h2>
          <ul class="mt-3 list-disc pl-5 text-slate-700 space-y-2">
            <li>Flat EPC from £70.</li>
            <li>House EPC from £85.</li>
            <li>Bungalow EPC from £80.</li>
            <li>Maisonette EPC from £75.</li>
          </ul>
        </article>
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Local coverage</h2>
          <p class="mt-3 text-slate-700">Appointments can cover Bishopbriggs and nearby areas such as Kirkintilloch, Lenzie, Springburn, Robroyston, Bearsden and wider Glasgow.</p>
        </article>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Useful related pages</h2>
        <p class="mt-2 text-slate-700">You can also book <a class="text-link" href="/epc-glasgow">EPC Glasgow</a>, <a class="text-link" href="/epc-bearsden">EPC Bearsden</a>, or add a <a class="text-link" href="/legionella-risk-assessment-glasgow">Legionella risk assessment in Glasgow</a>. For both services together, use the <a class="text-link" href="/#quote">instant quote form</a>.</p>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Bishopbriggs EPC FAQs</h2>
        <div class="mt-4 space-y-4 text-slate-700">
          <div>
            <h3 class="font-semibold text-slate-900">Who needs an EPC in Bishopbriggs?</h3>
            <p>An EPC is commonly needed when selling or renting a domestic property. Scotland EPC supports Bishopbriggs landlords, homeowners, sellers and agents.</p>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900">What property types can be assessed?</h3>
            <p>Flats, houses, bungalows, maisonettes and other domestic property types can be quoted through the online form.</p>
          </div>
          <div>
            <h3 class="font-semibold text-slate-900">Do you cover areas around Bishopbriggs?</h3>
            <p>Yes. Nearby areas include Kirkintilloch, Lenzie, Springburn, Robroyston, Bearsden and Glasgow.</p>
          </div>
        </div>
      </div>

      <div class="quote-card quote-card--primary">
        <h2 class="text-2xl font-semibold text-slate-900">Get a Bishopbriggs EPC quote</h2>
        <p class="mt-2 text-slate-700">Add your property type and postcode for a quick estimate.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn-primary" href="/#quote">Get Instant Quote</a>
          <a class="btn-secondary" href="tel:+447483881889">Call 07483 881889</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
