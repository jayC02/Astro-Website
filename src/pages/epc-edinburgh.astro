---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://scotlandepc.com/' },
    { '@type': 'ListItem', position: 2, name: 'EPC Edinburgh', item: 'https://scotlandepc.com/epc-edinburgh' },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'EPC assessments in Edinburgh',
  serviceType: 'Domestic EPC / RdSAP assessment',
  provider: { '@type': 'LocalBusiness', name: 'Scotland EPC', telephone: '+44 7483 881889' },
  areaServed: ['Edinburgh', 'Leith', 'Morningside', 'Corstorphine', 'Musselburgh', 'Central Scotland'],
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: '70', description: 'Domestic EPCs from £70.' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you provide EPCs across Edinburgh?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Scotland EPC supports domestic EPC bookings across Edinburgh and nearby areas, subject to appointment availability.' } },
    { '@type': 'Question', name: 'Can I request a preferred appointment date?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The quote form lets you request a preferred assessment date and include access notes.' } },
    { '@type': 'Question', name: 'Can an Edinburgh EPC be bundled with Legionella?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. EPC and Legionella risk assessments can be requested together from £100 where both services are practical for the booking.' } },
  ],
};
---

<Layout
  title="EPC Edinburgh | Domestic RdSAP Certificates from £70 | Scotland EPC"
  description="Arrange an Edinburgh EPC with Scotland EPC. Domestic RdSAP assessments for landlords, sellers, homeowners and agents, with EPCs from £70."
  canonicalPath="/epc-edinburgh"
>
  <section class="local-page">
    <div class="container-pro max-w-4xl space-y-6">
      <p class="badge">Edinburgh EPC appointments</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">EPC Assessments in Edinburgh</h1>
      <p class="text-lg text-slate-700">Scotland EPC helps Edinburgh landlords, homeowners, sellers and letting agents arrange domestic EPC/RdSAP assessments with clear pricing and a straightforward enquiry process.</p>

      <div class="quote-card border-sky-200 bg-sky-50">
        <h2 class="text-2xl font-semibold text-slate-900">Who this is for</h2>
        <p class="mt-2 text-slate-700">Landlords preparing for a new tenancy, homeowners selling a flat or house, letting agents arranging documentation and property managers coordinating compliance work.</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Suitable property types</h2>
          <ul class="mt-3 list-disc pl-5 text-slate-700 space-y-2">
            <li>Flats, houses, bungalows and maisonettes.</li>
            <li>Single property or multiple-property quote requests.</li>
            <li>Optional Legionella assessment when landlord paperwork is also needed.</li>
          </ul>
        </article>
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Edinburgh coverage</h2>
          <p class="mt-3 text-slate-700">Appointments can cover Edinburgh and nearby areas including Leith, Morningside, Corstorphine, Portobello, Musselburgh and wider Central Scotland.</p>
        </article>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Related services</h2>
        <p class="mt-2 text-slate-700">If you need water-system risk paperwork too, see <a class="text-link" href="/legionella-risk-assessment-edinburgh">Legionella risk assessments in Edinburgh</a>. You can also view <a class="text-link" href="/epc-glasgow">EPC Glasgow</a> or request the <a class="text-link" href="/#quote">EPC + Legionella bundle</a>.</p>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Edinburgh EPC FAQs</h2>
        <div class="mt-4 space-y-4 text-slate-700">
          <div><h3 class="font-semibold text-slate-900">Do you provide EPCs across Edinburgh?</h3><p>Yes. Scotland EPC supports domestic EPC bookings across Edinburgh and nearby areas, subject to appointment availability.</p></div>
          <div><h3 class="font-semibold text-slate-900">Can I request a preferred appointment date?</h3><p>Yes. The quote form lets you request a preferred assessment date and include access notes.</p></div>
          <div><h3 class="font-semibold text-slate-900">Can an Edinburgh EPC be bundled with Legionella?</h3><p>Yes. EPC and Legionella risk assessments can be requested together from £100 where both services are practical for the booking.</p></div>
        </div>
      </div>

      <div class="quote-card quote-card--primary">
        <h2 class="text-2xl font-semibold text-slate-900">Get an Edinburgh EPC quote</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn-primary" href="/#quote">Get Instant Quote</a>
          <a class="btn-secondary" href="tel:+447483881889">Call 07483 881889</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
