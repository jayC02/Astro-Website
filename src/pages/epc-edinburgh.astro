---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="EPC (RdSAP) Assessments in Edinburgh | Scottish Energy Services"
  description="Book an Edinburgh EPC (RdSAP) assessment with Scottish Energy Services. Fast quote requests for landlords, homeowners, and managed properties."
  canonicalPath="/epc-edinburgh"
>
  <section class="py-12">
    <div class="container-pro max-w-4xl space-y-6">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">EPC (RdSAP) assessments in Edinburgh</h1>
      <p class="text-slate-700">
        Scottish Energy Services provides EPC (RdSAP) assessments for properties across Edinburgh, helping owners and landlords
        secure the documentation they need for letting, sales, and general compliance planning.
      </p>
      <div class="quote-card space-y-3">
        <h2 class="text-2xl font-semibold text-slate-900">Designed for straightforward property bookings</h2>
        <ul class="list-disc pl-5 text-slate-700 space-y-1">
          <li>Suitable for flats, houses, bungalows, and maisonettes.</li>
          <li>Online quote request with preferred date selection.</li>
          <li>Option to combine with a Legionella risk assessment in one booking.</li>
        </ul>
      </div>
      <p class="text-slate-700">
        Start now from the <a class="text-blue-700 hover:text-blue-900" href="/#quote">online quote section</a>, or check
        <a class="text-blue-700 hover:text-blue-900" href="/epc-glasgow">EPC services in Glasgow</a> if you manage properties in both cities.
      </p>
      <p class="text-slate-700">
        Need water-system risk support too? Visit the
        <a class="text-blue-700 hover:text-blue-900" href="/legionella-risk-assessment-edinburgh">Edinburgh Legionella risk assessment page</a>.
      </p>
    </div>
  </section>
</Layout>
