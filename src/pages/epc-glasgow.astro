---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://scotlandepc.com/' },
    { '@type': 'ListItem', position: 2, name: 'EPC Glasgow', item: 'https://scotlandepc.com/epc-glasgow' },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'EPC assessments in Glasgow',
  serviceType: 'Domestic EPC / RdSAP assessment',
  provider: { '@type': 'LocalBusiness', name: 'Scotland EPC', telephone: '+44 7483 881889' },
  areaServed: ['Glasgow', 'Bearsden', 'Bishopbriggs', 'Anniesland', 'Springburn', 'Central Scotland'],
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: '70', description: 'Domestic EPCs from £70.' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'How much is an EPC in Glasgow?', acceptedAnswer: { '@type': 'Answer', text: 'EPCs start from £70 for flats, with houses from £85, bungalows from £80 and maisonettes from £75.' } },
    { '@type': 'Question', name: 'Can landlords book EPC and Legionella together?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Glasgow landlords can request an EPC and Legionella bundle from £100 when both services are booked together.' } },
    { '@type': 'Question', name: 'Which Glasgow areas do you cover?', acceptedAnswer: { '@type': 'Answer', text: 'Coverage includes Glasgow and nearby areas such as Bearsden, Bishopbriggs, Anniesland, Springburn and surrounding Central Belt locations.' } },
  ],
};
---

<Layout
  title="EPC Glasgow | Domestic RdSAP Certificates from £70 | Scotland EPC"
  description="Book a Glasgow EPC with Scotland EPC. Domestic RdSAP assessments for landlords, sellers, homeowners and agents, with EPCs from £70."
  canonicalPath="/epc-glasgow"
>
  <section class="local-page">
    <div class="container-pro max-w-4xl space-y-6">
      <p class="badge">Glasgow EPC appointments</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">EPC Assessments in Glasgow</h1>
      <p class="text-lg text-slate-700">Need an EPC in Glasgow for a rental, sale or compliance check? Scotland EPC provides domestic RdSAP assessments with clear pricing, simple booking and useful communication before the appointment.</p>

      <div class="quote-card border-sky-200 bg-sky-50">
        <h2 class="text-2xl font-semibold text-slate-900">Who this is for</h2>
        <p class="mt-2 text-slate-700">Glasgow landlords, homeowners, sellers, letting agents and property managers who need an EPC certificate for a domestic property.</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">What to expect</h2>
          <ul class="mt-3 list-disc pl-5 text-slate-700 space-y-2">
            <li>Domestic EPC/RdSAP assessment for rental or sale use.</li>
            <li>Prices from £70, with property type shown in the quote form.</li>
            <li>Option to add a Legionella risk assessment from the same enquiry.</li>
          </ul>
        </article>
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Glasgow and nearby areas</h2>
          <p class="mt-3 text-slate-700">Coverage includes Glasgow city areas plus nearby locations such as Bearsden, Bishopbriggs, Anniesland, Springburn, Robroyston and the Central Belt.</p>
        </article>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Related services</h2>
        <p class="mt-2 text-slate-700">Need landlord water-system paperwork too? See <a class="text-link" href="/legionella-risk-assessment-glasgow">Legionella risk assessments in Glasgow</a> or request the <a class="text-link" href="/#quote">EPC + Legionella bundle</a>. Nearby EPC pages include <a class="text-link" href="/epc-bearsden">Bearsden</a> and <a class="text-link" href="/epc-bishopbriggs">Bishopbriggs</a>.</p>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Glasgow EPC FAQs</h2>
        <div class="mt-4 space-y-4 text-slate-700">
          <div><h3 class="font-semibold text-slate-900">How much is an EPC in Glasgow?</h3><p>EPCs start from £70 for flats, with houses from £85, bungalows from £80 and maisonettes from £75.</p></div>
          <div><h3 class="font-semibold text-slate-900">Can landlords book EPC and Legionella together?</h3><p>Yes. Glasgow landlords can request an EPC and Legionella bundle from £100 when both services are booked together.</p></div>
          <div><h3 class="font-semibold text-slate-900">Which Glasgow areas do you cover?</h3><p>Coverage includes Glasgow and nearby areas such as Bearsden, Bishopbriggs, Anniesland, Springburn and surrounding Central Belt locations.</p></div>
        </div>
      </div>

      <div class="quote-card quote-card--primary">
        <h2 class="text-2xl font-semibold text-slate-900">Get a Glasgow EPC quote</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn-primary" href="/#quote">Get Instant Quote</a>
          <a class="btn-secondary" href="tel:+447483881889">Call 07483 881889</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
