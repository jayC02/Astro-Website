---
import Layout from '../layouts/Layout.astro';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Scotland EPC',
  url: 'https://scotlandepc.com',
  telephone: '+44 7483 881889',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '272 Bath St',
    addressLocality: 'Glasgow',
    postalCode: 'G2 4JR',
    addressCountry: 'GB',
  },
  areaServed: ['Glasgow', 'Edinburgh', 'Bearsden', 'Bishopbriggs', 'Central Scotland'],
  makesOffer: [
    {
      '@type': 'Offer',
      name: 'Domestic EPC assessment',
      price: '70',
      priceCurrency: 'GBP',
      itemOffered: { '@type': 'Service', name: 'EPC (RdSAP) assessments' },
    },
    {
      '@type': 'Offer',
      name: 'EPC and Legionella bundle',
      price: '100',
      priceCurrency: 'GBP',
      itemOffered: { '@type': 'Service', name: 'EPC and Legionella risk assessment bundle' },
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does an EPC cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Domestic EPC prices start from £70 for flats. Houses are £85, bungalows are £80 and maisonettes are £75. A £20 travel premium may apply outside the main Glasgow and Edinburgh postcode zones.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I book an EPC and Legionella assessment together?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Scotland EPC offers an EPC and Legionella bundle from £100 when both services are booked together.',
      },
    },
    {
      '@type': 'Question',
      name: 'What areas do you cover?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Scotland EPC covers Glasgow, Edinburgh, Bearsden, Bishopbriggs and nearby Central Belt areas.',
      },
    },
    {
      '@type': 'Question',
      name: 'Who uses Scotland EPC?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Typical customers include landlords, homeowners, sellers, letting agents and property managers who need EPC or Legionella documentation.',
      },
    },
  ],
};
---

<Layout
  title="EPC & Legionella Assessments Glasgow, Edinburgh | Scotland EPC"
  description="Get an instant quote for EPC and Legionella risk assessments across Glasgow, Edinburgh and Central Scotland. EPCs from £70 and EPC + Legionella from £100."
  canonicalPath="/"
>
  <section class="hero-section">
    <div class="container-pro grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(390px,0.82fr)] lg:items-start lg:py-14">
      <div class="pt-2 lg:pt-6">
        <p class="badge">Domestic property compliance</p>
        <h1 class="hero-title">EPC & Legionella Risk Assessments in Glasgow, Edinburgh and Central Scotland</h1>
        <p class="hero-copy">Clear prices, practical appointments and straightforward reports for landlords, homeowners, sellers, letting agents and property managers.</p>
        <p class="mt-4 text-sm font-bold text-slate-950 sm:hidden">EPCs from £70 · EPC + Legionella from £100</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#quote" class="btn-primary">Get Instant Quote</a>
          <a href="tel:+447483881889" class="btn-secondary">Call 07483 881889</a>
        </div>

        <dl class="mt-8 hidden max-w-2xl grid-cols-2 gap-x-6 gap-y-5 border-t border-slate-300 pt-5 sm:grid">
          <div>
            <dt class="text-sm text-slate-500">EPC assessments</dt>
            <dd class="mt-1 text-2xl font-bold text-slate-950">From £70</dd>
          </div>
          <div>
            <dt class="text-sm text-slate-500">EPC + Legionella</dt>
            <dd class="mt-1 text-2xl font-bold text-emerald-800">From £100</dd>
          </div>
          <div>
            <dt class="text-sm text-slate-500">Coverage</dt>
            <dd class="mt-1 font-bold text-slate-900">Glasgow, Edinburgh & Central Belt</dd>
          </div>
          <div>
            <dt class="text-sm text-slate-500">Response</dt>
            <dd class="mt-1 font-bold text-slate-900">Fast turnaround</dd>
          </div>
        </dl>
      </div>

      <div id="quote" class="quote-card quote-card--primary">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="section-kicker">Quick estimate</p>
            <h2 class="mt-1 text-2xl font-bold text-slate-950">Get your instant quote</h2>
          </div>
          <p class="shrink-0 rounded-md bg-emerald-50 px-2.5 py-1.5 text-xs font-bold text-emerald-800">No obligation</p>
        </div>
        <p class="mt-2 text-sm leading-6 text-slate-600">Enter the essentials. We will confirm the final price and appointment before booking.</p>

        <form id="quoteForm" class="mt-5 space-y-4">
          <fieldset>
            <legend class="form-label">Service needed</legend>
            <div class="service-grid">
              <label class="check-card"><input type="radio" name="service" value="EPC / RdSAP" checked /> EPC</label>
              <label class="check-card"><input type="radio" name="service" value="Legionella" /> Legionella</label>
              <label class="check-card"><input type="radio" name="service" value="Both" /> Both</label>
            </div>
          </fieldset>

          <div class="grid gap-4 sm:grid-cols-2">
            <label>
              <span class="form-label">Property type</span>
              <select class="input" id="propertyType" name="propertyType" required>
                <option value="Flat">Flat</option>
                <option value="House">House</option>
                <option value="Bungalow">Bungalow</option>
                <option value="Maisonette">Maisonette</option>
                <option value="Other">Other</option>
              </select>
            </label>
            <label>
              <span class="form-label">Property postcode</span>
              <input class="input" type="text" id="postcode" name="postcode" autocomplete="postal-code" placeholder="G1 1AA" required />
            </label>
          </div>

          <div class="quote-summary" aria-live="polite">
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-sm font-semibold text-sky-950">Estimated price</p>
              <p id="quoteTotal" class="text-2xl font-bold text-slate-950">£70</p>
            </div>
            <p id="quoteBreakdown" class="mt-1 text-xs leading-5 text-slate-600">Flat EPC. Enter a postcode to check the travel zone.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label>
              <span class="form-label">Name</span>
              <input class="input" type="text" name="customerName" autocomplete="name" required placeholder="Your name" />
            </label>
            <label>
              <span class="form-label">Phone</span>
              <input class="input" type="tel" name="customerPhone" autocomplete="tel" required placeholder="07..." />
            </label>
          </div>

          <label>
            <span class="form-label">Email</span>
            <input class="input" type="email" name="customerEmail" autocomplete="email" required placeholder="you@example.com" />
          </label>

          <label>
            <span class="form-label">Notes <span class="font-normal text-slate-500">(optional)</span></span>
            <textarea class="input min-h-20" name="notes" placeholder="Access details, timing or anything we should know"></textarea>
          </label>

          <button type="submit" class="btn-primary w-full">Send quote request</button>
          <p id="quoteStatus" class="hidden rounded-md px-3 py-2 text-sm" role="status" aria-live="polite"></p>
        </form>

        <ul class="reassurance-list mt-5 border-t border-slate-200 pt-4 sm:grid-cols-1">
          <li>Same-day response where possible</li>
          <li>Clear pricing before booking</li>
          <li>Glasgow, Edinburgh and Central Scotland</li>
        </ul>
      </div>
    </div>
  </section>

  <section aria-label="Key service information" class="border-b border-slate-200 bg-white">
    <div class="container-pro trust-strip border-y-0">
      <div class="trust-item"><p class="text-xs font-bold uppercase text-slate-500">Flat EPC</p><p class="mt-1 text-xl font-bold">£70</p></div>
      <div class="trust-item"><p class="text-xs font-bold uppercase text-slate-500">House EPC</p><p class="mt-1 text-xl font-bold">£85</p></div>
      <div class="trust-item"><p class="text-xs font-bold uppercase text-slate-500">Legionella</p><p class="mt-1 text-xl font-bold">£55</p></div>
      <div class="trust-item"><p class="text-xs font-bold uppercase text-emerald-700">Best-value bundle</p><p class="mt-1 text-xl font-bold">Both from £100</p></div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="container-pro">
      <div class="max-w-2xl">
        <p class="section-kicker">Services</p>
        <h2 class="section-heading">The property checks you need, without the runaround</h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <article class="service-panel">
          <p class="text-sm font-bold text-sky-800">01 / EPC</p>
          <h3 class="mt-3 text-xl font-bold">Domestic EPC certificates</h3>
          <p class="mt-2 leading-7 text-slate-600">RdSAP assessments for selling, renting and landlord compliance, with pricing based on property type.</p>
          <p class="mt-4"><a class="text-link" href="/epc-glasgow">Glasgow</a> · <a class="text-link" href="/epc-edinburgh">Edinburgh</a></p>
        </article>
        <article class="service-panel">
          <p class="text-sm font-bold text-sky-800">02 / Legionella</p>
          <h3 class="mt-3 text-xl font-bold">Legionella risk assessments</h3>
          <p class="mt-2 leading-7 text-slate-600">Practical domestic water-system checks and clear records for landlords, agents and property managers.</p>
          <p class="mt-4"><a class="text-link" href="/legionella-risk-assessment-glasgow">Glasgow</a> · <a class="text-link" href="/legionella-risk-assessment-edinburgh">Edinburgh</a></p>
        </article>
        <article class="service-panel border-emerald-700">
          <p class="text-sm font-bold text-emerald-700">03 / Bundle</p>
          <h3 class="mt-3 text-xl font-bold">EPC + Legionella from £100</h3>
          <p class="mt-2 leading-7 text-slate-600">Arrange both services through one enquiry and save against booking the assessments separately.</p>
          <p class="mt-4"><a class="text-link" href="#quote">Check your price</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-100 py-12 md:py-16">
    <div class="container-pro grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="section-kicker">Why Scotland EPC</p>
        <h2 class="section-heading">Clear, local and easy to arrange</h2>
        <p class="mt-4 leading-7 text-slate-600">You will know the likely cost early, who the service is for and what happens next. No vague packages or unnecessary booking steps.</p>
      </div>
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        <div class="border-t border-slate-400 pt-3"><h3 class="font-bold">Pricing before booking</h3><p class="mt-1 text-sm leading-6 text-slate-600">A useful estimate is shown immediately and confirmed before the appointment.</p></div>
        <div class="border-t border-slate-400 pt-3"><h3 class="font-bold">One enquiry for both</h3><p class="mt-1 text-sm leading-6 text-slate-600">EPC and Legionella work can be arranged together where practical.</p></div>
        <div class="border-t border-slate-400 pt-3"><h3 class="font-bold">Local coverage</h3><p class="mt-1 text-sm leading-6 text-slate-600">Regular coverage across Glasgow, Edinburgh and surrounding Central Belt areas.</p></div>
        <div class="border-t border-slate-400 pt-3"><h3 class="font-bold">Direct communication</h3><p class="mt-1 text-sm leading-6 text-slate-600">Straight answers about access, timing, property details and next steps.</p></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="container-pro grid gap-12 lg:grid-cols-2">
      <div>
        <p class="section-kicker">How it works</p>
        <h2 class="section-heading">From quote to report in four steps</h2>
        <ol class="mt-6 space-y-5">
          <li class="grid grid-cols-[2rem_1fr] gap-3"><span class="font-bold text-sky-800">01</span><div><h3 class="font-bold">Request a quote</h3><p class="mt-1 text-slate-600">Choose the service, property type and postcode.</p></div></li>
          <li class="grid grid-cols-[2rem_1fr] gap-3"><span class="font-bold text-sky-800">02</span><div><h3 class="font-bold">Confirm the details</h3><p class="mt-1 text-slate-600">We confirm the price, access and a suitable appointment.</p></div></li>
          <li class="grid grid-cols-[2rem_1fr] gap-3"><span class="font-bold text-sky-800">03</span><div><h3 class="font-bold">Property visit</h3><p class="mt-1 text-slate-600">The required assessment is completed at the property.</p></div></li>
          <li class="grid grid-cols-[2rem_1fr] gap-3"><span class="font-bold text-sky-800">04</span><div><h3 class="font-bold">Receive your paperwork</h3><p class="mt-1 text-slate-600">Your certificate or report is issued after the visit.</p></div></li>
        </ol>
      </div>
      <div>
        <p class="section-kicker">Areas covered</p>
        <h2 class="section-heading">Glasgow, Edinburgh and nearby areas</h2>
        <p class="mt-4 leading-7 text-slate-600">Use a local page for service details and nearby-area information, or send a postcode through the quote form.</p>
        <nav aria-label="Service areas" class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-slate-300 pt-5">
          <a class="text-link" href="/epc-glasgow">EPC Glasgow</a>
          <a class="text-link" href="/epc-edinburgh">EPC Edinburgh</a>
          <a class="text-link" href="/epc-bearsden">EPC Bearsden</a>
          <a class="text-link" href="/epc-bishopbriggs">EPC Bishopbriggs</a>
          <a class="text-link" href="/legionella-risk-assessment-glasgow">Legionella Glasgow</a>
          <a class="text-link" href="/legionella-risk-assessment-edinburgh">Legionella Edinburgh</a>
        </nav>
      </div>
    </div>
  </section>

  <section id="faq" class="border-y border-slate-200 bg-slate-100 py-12 md:py-16">
    <div class="container-pro grid gap-8 lg:grid-cols-[0.65fr_1.35fr]">
      <div><p class="section-kicker">FAQs</p><h2 class="section-heading">Useful answers before you book</h2></div>
      <div class="divide-y divide-slate-300 border-y border-slate-300">
        <details class="group py-5" open><summary class="cursor-pointer list-none font-bold">How much does an EPC cost?</summary><p class="mt-3 leading-7 text-slate-600">Domestic EPC prices start from £70 for flats. Houses are £85, bungalows are £80 and maisonettes are £75. A £20 travel premium may apply outside the main Glasgow and Edinburgh postcode zones.</p></details>
        <details class="group py-5"><summary class="cursor-pointer list-none font-bold">Can I book an EPC and Legionella assessment together?</summary><p class="mt-3 leading-7 text-slate-600">Yes. The EPC + Legionella bundle starts from £100 when both services are booked together.</p></details>
        <details class="group py-5"><summary class="cursor-pointer list-none font-bold">What areas do you cover?</summary><p class="mt-3 leading-7 text-slate-600">We cover Glasgow, Edinburgh, Bearsden, Bishopbriggs and nearby Central Belt areas.</p></details>
        <details class="group py-5"><summary class="cursor-pointer list-none font-bold">Who uses Scotland EPC?</summary><p class="mt-3 leading-7 text-slate-600">Landlords, homeowners, sellers, letting agents and property managers use the service for property compliance paperwork.</p></details>
      </div>
    </div>
  </section>

  <section id="contact" class="bg-sky-950 py-12 text-white md:py-16">
    <div class="container-pro grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="text-sm font-bold uppercase text-sky-200">Ready to arrange an assessment?</p>
        <h2 class="mt-2 text-3xl font-bold">Get a clear quote for your property</h2>
        <p class="mt-3 max-w-2xl text-sky-100">Use the instant form for the quickest estimate, or call to discuss access, multiple properties or timing.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary bg-white text-sky-950 hover:bg-sky-100" href="#quote">Get Instant Quote</a>
        <a class="btn-secondary border-white/40 bg-transparent text-white hover:bg-white/10" href="tel:+447483881889">Call 07483 881889</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script>
    const quoteForm = document.getElementById('quoteForm');
    const quoteTotal = document.getElementById('quoteTotal');
    const quoteBreakdown = document.getElementById('quoteBreakdown');
    const quoteStatus = document.getElementById('quoteStatus');
    const quoteSubmit = quoteForm?.querySelector('button[type="submit"]');
    const submitEndpoint = 'https://formsubmit.co/ajax/jay@scottishenergyservices.co.uk';
    const epcPrices = { Flat: 70, House: 85, Bungalow: 80, Maisonette: 75, Other: 85 };

    const getEstimate = () => {
      if (!(quoteForm instanceof HTMLFormElement)) return { total: 0, detail: '' };
      const data = new FormData(quoteForm);
      const service = String(data.get('service') || 'EPC / RdSAP');
      const propertyType = String(data.get('propertyType') || 'Flat');
      const postcode = String(data.get('postcode') || '').trim().toUpperCase();
      const base = service === 'Both' ? 100 : service === 'Legionella' ? 55 : epcPrices[propertyType] || 85;
      const outsideMainZone = postcode && !postcode.startsWith('G') && !postcode.startsWith('EH');
      const total = base + (outsideMainZone ? 20 : 0);
      const serviceLabel = service === 'Both' ? 'EPC + Legionella bundle' : service === 'Legionella' ? 'Legionella assessment' : `${propertyType} EPC`;
      const zoneLabel = !postcode ? 'Enter a postcode to check the travel zone.' : outsideMainZone ? 'Includes £20 travel premium outside main G/EH zones.' : 'Main Glasgow/Edinburgh postcode zone.';
      return { total, detail: `${serviceLabel}. ${zoneLabel}` };
    };

    const updateEstimate = () => {
      const estimate = getEstimate();
      if (quoteTotal) quoteTotal.textContent = `£${estimate.total}`;
      if (quoteBreakdown) quoteBreakdown.textContent = estimate.detail;
    };

    quoteForm?.addEventListener('input', updateEstimate);
    quoteForm?.addEventListener('change', updateEstimate);
    updateEstimate();

    quoteForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(quoteForm instanceof HTMLFormElement)) return;

      const data = Object.fromEntries(new FormData(quoteForm).entries());
      const estimate = getEstimate();
      const body = [
        `Name: ${data.customerName}`,
        `Phone: ${data.customerPhone}`,
        `Email: ${data.customerEmail}`,
        `Service: ${data.service}`,
        `Property type: ${data.propertyType}`,
        `Postcode: ${data.postcode}`,
        `Estimated quote: £${estimate.total}`,
        '',
        `Notes: ${data.notes || 'None supplied'}`,
      ].join('\n');
      const originalLabel = quoteSubmit?.textContent || 'Send quote request';

      if (quoteSubmit instanceof HTMLButtonElement) {
        quoteSubmit.disabled = true;
        quoteSubmit.textContent = 'Sending request...';
      }
      if (quoteStatus) quoteStatus.classList.add('hidden');

      try {
        const response = await fetch(submitEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: 'New Scotland EPC quote request',
            email: data.customerEmail,
            message: body,
          }),
        });
        if (!response.ok) throw new Error('Quote request failed');

        if (quoteStatus) {
          quoteStatus.textContent = 'Thanks. Your quote request has been sent and we will respond as soon as possible.';
          quoteStatus.className = 'rounded-md bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-900';
        }
        quoteForm.reset();
        updateEstimate();
      } catch (error) {
        if (quoteStatus) {
          quoteStatus.textContent = 'We could not send the form directly. Your email app is opening with the request ready to send.';
          quoteStatus.className = 'rounded-md bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900';
        }
        window.location.href = `mailto:jay@scottishenergyservices.co.uk?subject=${encodeURIComponent('New Scotland EPC quote request')}&body=${encodeURIComponent(body)}`;
      } finally {
        if (quoteSubmit instanceof HTMLButtonElement) {
          quoteSubmit.disabled = false;
          quoteSubmit.textContent = originalLabel;
        }
      }
    });
  </script>
</Layout>
