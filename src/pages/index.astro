---
import Layout from '../layouts/Layout.astro';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Scotland EPC',
  url: 'https://scotlandepc.com',
  telephone: '+44 7483 881889',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '272 Bath St',
    addressLocality: 'Glasgow',
    postalCode: 'G2 4JR',
    addressCountry: 'GB',
  },
  areaServed: [
    {
      '@type': 'AdministrativeArea',
      name: 'Glasgow',
    },
    {
      '@type': 'AdministrativeArea',
      name: 'Edinburgh',
    },
    {
      '@type': 'AdministrativeArea',
      name: 'Scotland',
    },
  ],
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'EPC (RdSAP) assessments',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Legionella risk assessments',
      },
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long is an EPC valid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An EPC is valid for 10 years.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do landlords need a Legionella risk assessment?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Landlords are responsible for ensuring the risk of Legionella is assessed and managed in their rental properties.',
      },
    },
    {
      '@type': 'Question',
      name: 'What areas do you cover?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We cover Glasgow, Edinburgh and surrounding areas across the central belt.',
      },
    },
  ],
};
---

<Layout
  title="EPC Glasgow & Edinburgh | Legionella Risk Assessment | Scotland EPC"
  description="Fast EPC and Legionella risk assessments in Glasgow and Edinburgh. Get an instant quote and book quickly with Scotland EPC."
  canonicalPath="/"
>
  <section class="hero-section">
    <div class="container-pro py-10 md:py-16">
      <p class="badge">Scotland EPC</p>
      <h1 class="hero-title">EPC & Legionella Risk Assessments in Glasgow & Edinburgh</h1>
      <p class="hero-copy">
        Fast, reliable EPC (RdSAP) and Legionella risk assessments across Glasgow, Edinburgh and surrounding areas. Get a quote in seconds and book at a time that suits you.
      </p>
      <p class="mt-4 text-slate-700 max-w-3xl">
        We provide straightforward, professional EPC and Legionella assessments for landlords, homeowners and letting agents. Whether you need a certificate for a new tenancy, a property sale, or a landlord compliance check, we make the process quick, simple and hassle-free.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/#quote" class="btn-primary">Get Your Quote</a>
        <a href="/#contact" class="btn-secondary">Request a Call Back</a>
      </div>
    </div>
  </section>

  <section class="pb-8">
    <div class="container-pro quote-card">
      <h2 class="text-2xl font-bold text-slate-900">Why Choose Scotland EPC</h2>
      <ul class="mt-4 list-disc pl-5 text-slate-700 space-y-2">
        <li>Fast turnaround times</li>
        <li>Flexible appointments across Glasgow & Edinburgh</li>
        <li>Simple online quote and booking process</li>
        <li>Experienced and reliable assessor</li>
        <li>Competitive, transparent pricing</li>
      </ul>
    </div>
  </section>

  <section class="pb-8">
    <div class="container-pro grid gap-4 md:grid-cols-2">
      <article class="quote-card">
        <h2 class="text-2xl font-bold text-slate-900">Our Services</h2>
        <h3 class="mt-3 text-xl font-semibold text-slate-900">EPC (RdSAP) Assessments</h3>
        <p class="mt-2 text-slate-700">Energy Performance Certificates (EPCs) are required when selling or renting a property. We carry out RdSAP assessments and provide clear, compliant certificates quickly and professionally.</p>
        <p class="mt-3"><a class="text-blue-700 hover:text-blue-900" href="/epc-glasgow">View EPC assessments in Glasgow</a> or <a class="text-blue-700 hover:text-blue-900" href="/epc-edinburgh">EPC assessments in Edinburgh</a>.</p>
      </article>
      <article class="quote-card">
        <h2 class="text-2xl font-bold text-slate-900">&nbsp;</h2>
        <h3 class="mt-3 text-xl font-semibold text-slate-900">Legionella Risk Assessments</h3>
        <p class="mt-2 text-slate-700">We assess your property’s water system to identify and reduce the risk of Legionella bacteria, helping landlords and property managers meet their responsibilities.</p>
        <p class="mt-3"><a class="text-blue-700 hover:text-blue-900" href="/legionella-risk-assessment-glasgow">Legionella risk assessment in Glasgow</a> and <a class="text-blue-700 hover:text-blue-900" href="/legionella-risk-assessment-edinburgh">Legionella risk assessment in Edinburgh</a>.</p>
      </article>
    </div>
  </section>

  <section class="pb-8">
    <div class="container-pro quote-card">
      <h2 class="text-2xl font-bold text-slate-900">How It Works</h2>
      <ol class="mt-4 list-decimal pl-5 text-slate-700 space-y-2">
        <li>Submit your details using our quick quote form</li>
        <li>Receive a clear price instantly</li>
        <li>Choose a suitable appointment time</li>
        <li>Assessment carried out at your property</li>
        <li>Receive your certificate or report</li>
      </ol>
    </div>
  </section>

  <section id="quote" class="pb-16">
    <div class="container-pro">
      <div class="quote-card quote-card--primary">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Request an instant quote</h2>
        <p class="mt-2 text-slate-600">Complete the property details below to generate your live quote.</p>
        <div class="deal-banner mt-4">
          <p class="text-sm font-semibold text-emerald-800">Special offer</p>
          <p class="text-slate-800"><strong>EPC + Legionella deal: £100</strong> for both, discounted from £120.</p>
        </div>

        <form id="quoteForm" class="quote-form mt-6 space-y-6">
          <div>
            <div class="flex items-center justify-between gap-4 mb-3">
              <h3 class="text-lg font-semibold text-slate-900">Property details</h3>
              <button type="button" id="addProperty" class="btn-secondary">+ Add property</button>
            </div>

            <div id="properties" class="space-y-4"></div>
          </div>

          <div class="grid md:grid-cols-3 gap-4">
            <label>
              <span class="form-label">Preferred assessment date</span>
              <input class="input" type="date" id="requiredDate" name="requiredDate" required />
            </label>
            <label>
              <span class="form-label">Your email</span>
              <input class="input" type="email" id="customerEmail" name="customerEmail" required placeholder="you@example.com" />
            </label>
            <label>
              <span class="form-label">Mobile number</span>
              <input class="input" type="tel" id="customerPhone" name="customerPhone" required placeholder="07..." />
            </label>
          </div>

          <label>
            <span class="form-label">Comments / access information</span>
            <textarea id="comment" name="comment" class="input min-h-28" placeholder="Tell us anything useful (parking, access times, tenancy details, etc.)."></textarea>
          </label>

          <div class="quote-summary" aria-live="polite">
            <p class="text-sm text-slate-500">Estimated total</p>
            <p id="quoteTotal" class="text-3xl font-bold text-slate-900">£0.00</p>
            <p id="quoteBreakdown" class="text-sm text-slate-600 whitespace-pre-line">Add at least one property with address and postcode to generate a quote.</p>
          </div>

          <button type="submit" class="btn-primary w-full md:w-auto">Submit request</button>
        </form>
      </div>
    </div>
  </section>

  <section class="pb-10" id="faq">
    <div class="container-pro quote-card">
      <h2 class="text-2xl font-bold text-slate-900">Common Questions</h2>
      <div class="mt-4 space-y-4 text-slate-700">
        <div>
          <h3 class="text-lg font-semibold text-slate-900">How long is an EPC valid?</h3>
          <p>An EPC is valid for 10 years.</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-slate-900">Do landlords need a Legionella risk assessment?</h3>
          <p>Landlords are responsible for ensuring the risk of Legionella is assessed and managed in their rental properties.</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-slate-900">What areas do you cover?</h3>
          <p>We cover Glasgow, Edinburgh and surrounding areas across the central belt.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="pb-20">
    <div class="container-pro">
      <div class="quote-card">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Contact</h2>
        <p class="mt-2 text-slate-600">If you have any questions or need help with your booking, get in touch directly.</p>
        <p class="mt-2 text-slate-700">Phone: <a class="text-blue-700 hover:text-blue-900" href="tel:+447483881889">+44 7483 881889</a></p>
        <p class="text-slate-700">Address: 272 Bath St, Glasgow G2 4JR</p>

        <form id="contactForm" class="mt-6 space-y-4">
          <div class="grid md:grid-cols-3 gap-4">
            <label>
              <span class="form-label">Your name</span>
              <input class="input" type="text" id="contactName" name="contactName" required placeholder="Jane Smith" />
            </label>
            <label>
              <span class="form-label">Your email</span>
              <input class="input" type="email" id="contactEmail" name="contactEmail" required placeholder="you@example.com" />
            </label>
            <label>
              <span class="form-label">Mobile number</span>
              <input class="input" type="tel" id="contactPhone" name="contactPhone" required placeholder="07..." />
            </label>
          </div>

          <label>
            <span class="form-label">Message</span>
            <textarea class="input min-h-32" id="contactMessage" name="contactMessage" required placeholder="How can we help?"></textarea>
          </label>

          <button type="submit" id="contactSubmit" class="btn-primary w-full md:w-auto">Send message</button>
        </form>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script>
    const servicePrices = { legionella: 55 };
    const bothDealPrice = 100;
    const epcByPropertyType = {
      Flat: 70,
      House: 85,
      Bungalow: 80,
      Maisonette: 75,
      Other: 85,
    };
    const travelPremium = 20;
    const propertiesContainer = document.getElementById('properties');
    const addPropertyButton = document.getElementById('addProperty');
    const form = document.getElementById('quoteForm');
    const quoteTotal = document.getElementById('quoteTotal');
    const quoteBreakdown = document.getElementById('quoteBreakdown');
    const requiredDateInput = document.getElementById('requiredDate');
    const contactForm = document.getElementById('contactForm');
    const contactSubmit = document.getElementById('contactSubmit');
    const quoteSubmit = form?.querySelector('button[type="submit"]');
    const submitEndpoint = 'https://formsubmit.co/ajax/jay@scottishenergyservices.co.uk';

    let propertyCount = 0;

    const createPropertyRow = () => {
      propertyCount += 1;
      const propertyId = propertyCount;
      const row = document.createElement('div');
      row.className = 'property-row';
      row.dataset.propertyId = String(propertyId);
      row.innerHTML = `
        <button type="button" class="remove-property" aria-label="Remove property">×</button>
        <fieldset class="md:col-span-2">
          <legend class="form-label">Assessment type</legend>
          <div class="service-grid">
            <label class="check-card">
              <input type="checkbox" name="services_${propertyId}" value="rdsap" checked />
              <span>
                <strong>RdSAP / EPC</strong>
              </span>
            </label>
            <label class="check-card">
              <input type="checkbox" name="services_${propertyId}" value="legionella" />
              <span>
                <strong>Legionella risk assessment</strong>
              </span>
            </label>
          </div>
        </fieldset>
        <div class="md:col-span-2">
          <label>
            <span class="form-label">Address ${propertyId}</span>
            <input class="input" type="text" name="address_${propertyId}" placeholder="${propertyId} Example Street, Town" required />
          </label>
        </div>
        <label>
          <span class="form-label">Postcode</span>
          <input class="input" type="text" name="postcode_${propertyId}" placeholder="G1 1AA" required />
        </label>
        <label>
          <span class="form-label">Property type</span>
          <select class="input" name="propertyType_${propertyId}" required>
            <option value="Flat">Flat</option>
            <option value="House">House</option>
            <option value="Maisonette">Maisonette</option>
            <option value="Bungalow">Bungalow</option>
            <option value="Other">Other</option>
          </select>
        </label>
      `;

      const removeButton = row.querySelector('.remove-property');
      removeButton?.addEventListener('click', () => {
        const propertyRows = [...propertiesContainer.querySelectorAll('.property-row')];
        if (propertyRows.length <= 1) return;
        row.remove();
        updateQuote();
      });

      propertiesContainer.appendChild(row);
      updateQuote();
    };

    const getSelectedServicesForRow = (row) => {
      const propertyId = row.dataset.propertyId;
      if (!propertyId) return [];
      return [...row.querySelectorAll(`input[name="services_${propertyId}"]:checked`)].map((el) => el.value);
    };

    const getLocationZoneFromPostcode = (postcode = '') => {
      const normalized = postcode.trim().toUpperCase();
      if (!normalized) return null;
      if (normalized.startsWith('G') || normalized.startsWith('EH')) return 'city';
      return 'outside';
    };

    const updateQuote = () => {
      const propertyRows = [...propertiesContainer.querySelectorAll('.property-row')];

      if (propertyRows.length === 0) {
        quoteTotal.textContent = '£0.00';
        quoteBreakdown.textContent = 'Add at least one property with address and postcode to generate a quote.';
        return;
      }

      const breakdownLines = [];
      const total = propertyRows.reduce((sum, row, index) => {
        const rowNumber = index + 1;
        const propertyId = row.dataset.propertyId;
        const selectedServices = getSelectedServicesForRow(row);
        const propertyType = row.querySelector(`[name="propertyType_${propertyId}"]`)?.value || 'Other';
        const address = row.querySelector(`[name="address_${propertyId}"]`)?.value?.trim() || '';
        const postcode = row.querySelector(`[name="postcode_${propertyId}"]`)?.value || '';
        const locationZone = getLocationZoneFromPostcode(postcode);

        if (selectedServices.length === 0) {
          breakdownLines.push(`Property ${rowNumber}: select at least one assessment type`);
          return sum;
        }

        if (!address || !postcode || !locationZone) {
          breakdownLines.push(`Property ${rowNumber}: waiting for full address + postcode`);
          return sum;
        }

        const hasEpc = selectedServices.includes('rdsap');
        const hasLegionella = selectedServices.includes('legionella');
        const epcPrice = hasEpc ? epcByPropertyType[propertyType] ?? epcByPropertyType.Other : 0;
        const legionellaPrice = hasLegionella ? servicePrices.legionella : 0;
        const locationPremium = locationZone === 'outside' ? travelPremium : 0;

        const serviceTotal = hasEpc && hasLegionella ? bothDealPrice : epcPrice + legionellaPrice;
        const rowTotal = serviceTotal + locationPremium;
        const locationLabel = locationZone === 'outside' ? 'Outside main cities' : 'Glasgow/Edinburgh';
        const parts = [];

        if (hasEpc && hasLegionella) {
          parts.push(`EPC + Legionella deal (£${bothDealPrice})`);
        } else {
          if (epcPrice) parts.push(`RdSAP ${propertyType} (£${epcPrice})`);
          if (legionellaPrice) parts.push(`Legionella (£${legionellaPrice})`);
        }
        if (locationPremium) parts.push(`Travel premium (+£${locationPremium})`);

        breakdownLines.push(`Property ${rowNumber}: ${locationLabel} — ${parts.join(' + ')}`);
        return sum + rowTotal;
      }, 0);

      quoteTotal.textContent = `£${total.toFixed(2)}`;
      quoteBreakdown.textContent = breakdownLines.join('\n');
    };

    createPropertyRow();
    if (requiredDateInput) {
      requiredDateInput.min = new Date().toISOString().split('T')[0];
    }

    addPropertyButton?.addEventListener('click', () => {
      createPropertyRow();
    });

    form?.addEventListener('change', updateQuote);

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      const today = new Date().toISOString().split('T')[0];
      if (typeof data.requiredDate === 'string' && data.requiredDate < today) {
        alert('Please choose a preferred assessment date from today onward.');
        return;
      }
      const propertyRows = [...propertiesContainer.querySelectorAll('.property-row')];
      const hasMissingServiceSelection = propertyRows.some((row) => getSelectedServicesForRow(row).length === 0);
      if (hasMissingServiceSelection) {
        alert('Please select at least one assessment type for each property.');
        return;
      }

      const propertyDetails = propertyRows
        .map((row, index) => {
          const rowNumber = index + 1;
          const propertyId = row.dataset.propertyId;
          const selectedServices = getSelectedServicesForRow(row);
          const serviceNames = selectedServices
            .map((service) => (service === 'rdsap' ? 'RdSAP / EPC' : 'Legionella risk assessment'))
            .join(' + ');
          const address = data[`address_${propertyId}`] || '';
          const postcode = data[`postcode_${propertyId}`] || '';
          const propertyType = data[`propertyType_${propertyId}`] || '';
          const locationZone = getLocationZoneFromPostcode(postcode) === 'outside' ? 'Outside Glasgow/Edinburgh' : 'Glasgow/Edinburgh';
          return `${rowNumber}. ${propertyType} (${locationZone}) - ${address}, ${postcode} [${serviceNames}]`;
        })
        .join('\n');

      const total = quoteTotal.textContent;
      const subject = encodeURIComponent('New assessment quote request');
      const body = [
        `Required date: ${data.requiredDate}`,
        `Customer email: ${data.customerEmail}`,
        `Customer mobile: ${data.customerPhone}`,
        `Estimated quote: ${total}`,
        '',
        'Properties:',
        propertyDetails,
        '',
        `Comments: ${data.comment || 'None supplied'}`,
      ].join('\n');
      const submitButtonLabel = quoteSubmit?.textContent;
      if (quoteSubmit) {
        quoteSubmit.disabled = true;
        quoteSubmit.textContent = 'Sending...';
      }

      try {
        const response = await fetch(submitEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: 'New assessment quote request',
            email: data.customerEmail,
            message: body,
          }),
        });

        if (!response.ok) throw new Error('Quote request failed');
        alert('Thanks — your quote request has been sent successfully.');
        form.reset();
        propertiesContainer.innerHTML = '';
        propertyCount = 0;
        createPropertyRow();
      } catch (error) {
        const fallbackMailto = `mailto:jay@scottishenergyservices.co.uk?subject=${subject}&body=${encodeURIComponent(body)}`;
        window.location.href = fallbackMailto;
      } finally {
        if (quoteSubmit) {
          quoteSubmit.disabled = false;
          quoteSubmit.textContent = submitButtonLabel || 'Submit request';
        }
      }
    });

    contactForm?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const contactData = new FormData(contactForm);
      const data = Object.fromEntries(contactData.entries());
      const subject = encodeURIComponent(`Website contact message from ${data.contactName}`);
      const body = [
        `Name: ${data.contactName}`,
        `Email: ${data.contactEmail}`,
        `Mobile: ${data.contactPhone}`,
        '',
        'Message:',
        `${data.contactMessage}`,
      ].join('\n');
      const contactLabel = contactSubmit?.textContent;
      if (contactSubmit) {
        contactSubmit.disabled = true;
        contactSubmit.textContent = 'Sending...';
      }

      try {
        const response = await fetch(submitEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: `Website contact message from ${data.contactName}`,
            email: data.contactEmail,
            message: body,
          }),
        });

        if (!response.ok) throw new Error('Contact message failed');
        alert('Thanks — your message has been sent.');
        contactForm.reset();
      } catch (error) {
        const fallbackMailto = `mailto:jay@scottishenergyservices.co.uk?subject=${subject}&body=${encodeURIComponent(body)}`;
        window.location.href = fallbackMailto;
      } finally {
        if (contactSubmit) {
          contactSubmit.disabled = false;
          contactSubmit.textContent = contactLabel || 'Send message';
        }
      }
    });
  </script>
</Layout>
