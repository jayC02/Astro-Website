---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://scotlandepc.com/' },
    { '@type': 'ListItem', position: 2, name: 'Legionella Edinburgh', item: 'https://scotlandepc.com/legionella-risk-assessment-edinburgh' },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Legionella risk assessments in Edinburgh',
  serviceType: 'Domestic Legionella risk assessment',
  provider: { '@type': 'LocalBusiness', name: 'Scotland EPC', telephone: '+44 7483 881889' },
  areaServed: ['Edinburgh', 'Leith', 'Morningside', 'Corstorphine', 'Musselburgh', 'Central Scotland'],
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: '55', description: 'Domestic Legionella risk assessments from £55.' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do Edinburgh landlords need to assess Legionella risk?', acceptedAnswer: { '@type': 'Answer', text: 'Landlords are responsible for assessing and managing Legionella risk in rental properties. This service helps document the domestic property check.' } },
    { '@type': 'Question', name: 'How much does the service cost?', acceptedAnswer: { '@type': 'Answer', text: 'Legionella risk assessments start from £55, with an EPC and Legionella bundle from £100.' } },
    { '@type': 'Question', name: 'Can I include access notes?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The quote form includes notes for access details, tenant arrangements and preferred appointment dates.' } },
  ],
};
---

<Layout
  title="Legionella Risk Assessment Edinburgh from £55 | Scotland EPC"
  description="Arrange an Edinburgh Legionella risk assessment with Scotland EPC. Domestic landlord checks from £55 or EPC + Legionella from £100."
  canonicalPath="/legionella-risk-assessment-edinburgh"
>
  <section class="local-page">
    <div class="container-pro max-w-4xl space-y-6">
      <p class="badge">Edinburgh Legionella appointments</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Legionella Risk Assessments in Edinburgh</h1>
      <p class="text-lg text-slate-700">Scotland EPC provides Edinburgh Legionella risk assessments for landlords, letting agents and property managers who want clear domestic water-system records and a dependable booking process.</p>

      <div class="quote-card border-sky-200 bg-sky-50">
        <h2 class="text-2xl font-semibold text-slate-900">Who this is for</h2>
        <p class="mt-2 text-slate-700">Landlords reviewing risk between tenancies, letting agents managing rental paperwork and property managers coordinating domestic compliance tasks.</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Why clients book this service</h2>
          <ul class="mt-3 list-disc pl-5 text-slate-700 space-y-2">
            <li>To document domestic water-system risk checks.</li>
            <li>To support landlord and letting-agent records.</li>
            <li>To combine with an EPC appointment where practical.</li>
          </ul>
        </article>
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Edinburgh coverage</h2>
          <p class="mt-3 text-slate-700">Coverage includes Edinburgh and nearby areas such as Leith, Morningside, Corstorphine, Portobello, Musselburgh and wider Central Scotland.</p>
        </article>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Related pages</h2>
        <p class="mt-2 text-slate-700">Related services include <a class="text-link" href="/epc-edinburgh">EPC assessments in Edinburgh</a>, <a class="text-link" href="/legionella-risk-assessment-glasgow">Legionella Glasgow</a> and the <a class="text-link" href="/#quote">EPC + Legionella bundle</a>.</p>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Edinburgh Legionella FAQs</h2>
        <div class="mt-4 space-y-4 text-slate-700">
          <div><h3 class="font-semibold text-slate-900">Do Edinburgh landlords need to assess Legionella risk?</h3><p>Landlords are responsible for assessing and managing Legionella risk in rental properties. This service helps document the domestic property check.</p></div>
          <div><h3 class="font-semibold text-slate-900">How much does the service cost?</h3><p>Legionella risk assessments start from £55, with an EPC and Legionella bundle from £100.</p></div>
          <div><h3 class="font-semibold text-slate-900">Can I include access notes?</h3><p>Yes. The quote form includes notes for access details, tenant arrangements and preferred appointment dates.</p></div>
        </div>
      </div>

      <div class="quote-card quote-card--primary">
        <h2 class="text-2xl font-semibold text-slate-900">Get an Edinburgh Legionella quote</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn-primary" href="/#quote">Get Instant Quote</a>
          <a class="btn-secondary" href="tel:+447483881889">Call 07483 881889</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
