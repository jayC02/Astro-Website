---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://scotlandepc.com/' },
    { '@type': 'ListItem', position: 2, name: 'Legionella Glasgow', item: 'https://scotlandepc.com/legionella-risk-assessment-glasgow' },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Legionella risk assessments in Glasgow',
  serviceType: 'Domestic Legionella risk assessment',
  provider: { '@type': 'LocalBusiness', name: 'Scotland EPC', telephone: '+44 7483 881889' },
  areaServed: ['Glasgow', 'Bearsden', 'Bishopbriggs', 'Central Scotland'],
  offers: { '@type': 'Offer', priceCurrency: 'GBP', price: '55', description: 'Domestic Legionella risk assessments from £55.' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'How much is a Glasgow Legionella risk assessment?', acceptedAnswer: { '@type': 'Answer', text: 'Legionella risk assessments start from £55, or from £100 when bundled with an EPC.' } },
    { '@type': 'Question', name: 'Who books this service?', acceptedAnswer: { '@type': 'Answer', text: 'The service is commonly used by landlords, letting agents and property managers responsible for domestic rental properties.' } },
    { '@type': 'Question', name: 'Can it be completed with an EPC?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Where practical, an EPC and Legionella risk assessment can be requested together through the quote form.' } },
  ],
};
---

<Layout
  title="Legionella Risk Assessment Glasgow from £55 | Scotland EPC"
  description="Book a Glasgow Legionella risk assessment with Scotland EPC. Domestic landlord checks from £55 or EPC + Legionella from £100."
  canonicalPath="/legionella-risk-assessment-glasgow"
>
  <section class="local-page">
    <div class="container-pro max-w-4xl space-y-6">
      <p class="badge">Glasgow Legionella appointments</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900">Legionella Risk Assessments in Glasgow</h1>
      <p class="text-lg text-slate-700">For Glasgow rental properties, a Legionella risk assessment helps landlords and agents document sensible water-system checks and identify practical control measures. Scotland EPC keeps the process clear, direct and easy to arrange.</p>

      <div class="quote-card border-sky-200 bg-sky-50">
        <h2 class="text-2xl font-semibold text-slate-900">Who this is for</h2>
        <p class="mt-2 text-slate-700">Landlords, letting agents and property managers looking after domestic rental properties in Glasgow, Bearsden, Bishopbriggs and nearby Central Belt areas.</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Assessment focus</h2>
          <ul class="mt-3 list-disc pl-5 text-slate-700 space-y-2">
            <li>Domestic hot and cold water arrangements.</li>
            <li>Potential stagnation points and outlet usage patterns.</li>
            <li>Clear notes for landlord records and follow-up actions.</li>
          </ul>
        </article>
        <article class="quote-card">
          <h2 class="text-2xl font-semibold text-slate-900">Bundle option</h2>
          <p class="mt-3 text-slate-700">A standalone Legionella assessment starts from £55. If you also need an EPC, the combined bundle starts from £100.</p>
        </article>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Related pages</h2>
        <p class="mt-2 text-slate-700">You can also book an <a class="text-link" href="/epc-glasgow">EPC assessment in Glasgow</a>, view <a class="text-link" href="/epc-bearsden">EPC Bearsden</a>, <a class="text-link" href="/epc-bishopbriggs">EPC Bishopbriggs</a>, or compare <a class="text-link" href="/legionella-risk-assessment-edinburgh">Legionella Edinburgh</a>.</p>
      </div>

      <div class="quote-card">
        <h2 class="text-2xl font-semibold text-slate-900">Glasgow Legionella FAQs</h2>
        <div class="mt-4 space-y-4 text-slate-700">
          <div><h3 class="font-semibold text-slate-900">How much is a Glasgow Legionella risk assessment?</h3><p>Legionella risk assessments start from £55, or from £100 when bundled with an EPC.</p></div>
          <div><h3 class="font-semibold text-slate-900">Who books this service?</h3><p>The service is commonly used by landlords, letting agents and property managers responsible for domestic rental properties.</p></div>
          <div><h3 class="font-semibold text-slate-900">Can it be completed with an EPC?</h3><p>Yes. Where practical, an EPC and Legionella risk assessment can be requested together through the quote form.</p></div>
        </div>
      </div>

      <div class="quote-card quote-card--primary">
        <h2 class="text-2xl font-semibold text-slate-900">Get a Glasgow Legionella quote</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <a class="btn-primary" href="/#quote">Get Instant Quote</a>
          <a class="btn-secondary" href="tel:+447483881889">Call 07483 881889</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
